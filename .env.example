# Never commit real values — copy this file to .env locally

# Public Firebase client config (safe in the browser).
# Restrict this key in Google Cloud Console → APIs & Services → Credentials:
# Application restrictions → HTTP referrers, e.g.:
#   http://localhost:*/*
#   https://your-project.vercel.app/*
#   https://*.firebaseapp.com/*
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Stripe test keys only (Dashboard → Developers → API keys → Test mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here

# Service account (server-only — never NEXT_PUBLIC_)
# Used to write Firestore orders after payment. On Vercel paste WITHOUT outer quotes.
# Private key: one line, PEM with \n between lines, including BEGIN/END.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional; falls back to NEXT_PUBLIC_FIREBASE_PROJECT_ID
# FIREBASE_PROJECT_ID=your_project_id

# Optional
# NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Optional shared rate limiting (Upstash). Unset = in-memory per instance.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token
