# Never commit real values — copy this file to .env locally

# Public Firebase client config (safe to expose in the browser).
# Restrict this key in Google Cloud Console → APIs & Services → Credentials:
# Application restrictions → HTTP referrers, then allow:
#   http://localhost:*/*
#   https://your-project.vercel.app/*
#   https://*.firebaseapp.com/*
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Stripe test keys (Dashboard → Developers → API keys → Test mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here

# Firebase Admin SDK (server-only — never prefix with NEXT_PUBLIC_)
# Required on Vercel for /api/create-payment-intent and /api/save-order
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
# Paste as one line with \n for newlines (Vercel env UI). Include BEGIN/END lines.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional server-only override; falls back to NEXT_PUBLIC_FIREBASE_PROJECT_ID.
# Also used by: yarn deploy:firestore-rules and yarn smoke:checkout
# FIREBASE_PROJECT_ID=your_project_id

# Optional
# NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Optional shared rate limiting (Upstash Redis REST). When unset, in-memory limits apply.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token